<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- 用于引导用户把本应用加入电池优化白名单：三星「深度休眠」会连充电中的
         JobScheduler 任务一起阻断，导致插电兜底链路静默失效。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.sec.android.app.samsungapps" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CscChanger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CscChanger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tuning.BrightScreenFastChargeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled wired charging temperature-node control" />
        </service>

        <service
            android:name=".tuning.PassThroughService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled foreground app monitoring for USB PD bypass charging" />
        </service>

        <receiver
            android:name=".tuning.PassThroughReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tuning.FastChargeJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".tuning.FastChargeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 注意：Intent.ACTION_POWER_CONNECTED 常量值是 "android.intent.action.ACTION_POWER_CONNECTED"
                     （带 ACTION_ 前缀，这是 Android 里少数几个常量名与值同名前缀的历史遗留），
                     不要“顺手”改成 android.intent.action.POWER_CONNECTED，否则永远收不到。
                     另外：这两个 action 不在 Android 8+ 隐式广播豁免名单内，targetSdk≥26 时
                     静态注册收不到——插电感知必须依赖常驻前台服务里的动态注册，见
                     BrightScreenFastChargeService 与 FastChargeScheduler。 -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- ===== LSPosed 模块声明 =====
             已迁移到 libxposed 102 API：入口在 META-INF/xposed/java_init.list，
             配置跨进程读取走 getRemotePreferences（不再需要 legacy xposedsharedprefs 声明）。 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
